% Sphinx escapes the underscore to \_, which is an ordinary character.  A long
% identifier in a table cell has no break point and runs into the margin.
\let\pkgtextunderscore\_
\protected\def\_{\pkgtextunderscore\discretionary{}{}{}}
\pdfstringdefDisableCommands{\let\_\pkgtextunderscore}

% The inline literal uses a monospace font, which gives no break after a
% hyphen.  The \kern prevents the en-dash ligature.
\protected\def\pkgsphinxhyphenbreak#1{-\kern\z@\discretionary{}{}{}}
\renewcommand*{\sphinxhyphenininlineliteral}{\pkgsphinxhyphenbreak}

% TeX does not hyphenate a monospace font, so an inline literal such as
% abcDefGhi has no break point.  A break comes before an upper case letter
% which a lower case letter follows.  A token such as ABC_DEF_GHI keeps its
% letters together.  The activation makes every upper case letter an active
% character, so a lower case letter is the only letter left in the text.
\def\pkgupperchar#1{\def\pkgupperheld{#1}\futurelet\pkgnexttoken\pkgemitupper}
\def\pkgemitupper{%
  \ifcat\noexpand\pkgnexttoken a\discretionary{}{}{}\fi
  \pkgupperheld}
\def\pkgdoupper#1{%
  \lccode`\~`#1\relax
  \lowercase{\def~}{\pkgupperchar{#1}}%
  \catcode`#1\active}
\def\pkgactivateupper{%
  \pkgdoupper A\pkgdoupper B\pkgdoupper C\pkgdoupper D\pkgdoupper E%
  \pkgdoupper F\pkgdoupper G\pkgdoupper H\pkgdoupper I\pkgdoupper J%
  \pkgdoupper K\pkgdoupper L\pkgdoupper M\pkgdoupper N\pkgdoupper O%
  \pkgdoupper P\pkgdoupper Q\pkgdoupper R\pkgdoupper S\pkgdoupper T%
  \pkgdoupper U\pkgdoupper V\pkgdoupper W\pkgdoupper X\pkgdoupper Y%
  \pkgdoupper Z%
  \lccode`\~`\~}

% The activation stays local to \sphinxcode.  A code block reads its Pygments
% style keys under the catcodes of \sphinxbreaksviaactive.
%
% LaTeX reads a file such as a font definition when it first needs the file.
% An active upper case letter cuts the \ProvidesFile line of that file short.
% The probe sets the literal with the normal catcodes.  It reads every file
% which the literal needs.
\newbox\pkgprobebox
\let\pkgsphinxcode\sphinxcode
\protected\def\sphinxcode#1{{%
  \setbox\pkgprobebox\hbox{\pkgsphinxcode{#1}}%
  \let\pkgbreaksviaactive\sphinxbreaksviaactive
  \def\sphinxbreaksviaactive{\pkgbreaksviaactive\pkgactivateupper}%
  \pkgsphinxcode{#1}}}

\protected\def\sphinxstyletheadfamily{\py@HeaderFamily \py@TitleColor}

\renewcommand{\sphinxmaketitle}{
  \begin{titlepage}
    % For PDF information dictionary
    \begingroup
     \def\endgraf{ }\def\and{\& }
     \pdfstringdefDisableCommands{\def\\{, }}
     \hypersetup{pdfauthor={\@author}, pdftitle={\@title}}
    \endgroup

    \py@HeaderFamily

    \begin{tikzpicture}[remember picture,overlay]
      \node[yshift=-5cm,xshift=7cm] at (current page.north west) {
        \includegraphics[width=0.3\paperwidth]{logo.pdf}
      };
    \end{tikzpicture}

    \begin{tikzpicture}[remember picture,overlay]
    \begin{pgfonlayer}{background}
      \node[yshift=10cm] at (current page.south) {\includegraphics[width=\paperwidth,height=20cm]{blue-dots.pdf}};
    \end{pgfonlayer}
    \end{tikzpicture}

    \vspace{2.5cm}

    \begin{flushright}
    {\fontsize{50}{60}\selectfont \pkgprojecttitle}

    {\Huge Ready to Fly}

    \end{flushright}

    \vspace{6.0cm}

    \begin{flushleft}
    {\fontsize{40}{50}\selectfont \pkgtitlepagetitle}

    {\Huge \py@release}
    \end{flushleft}
  \end{titlepage}
}
% Fit the header and footer boxes to their content.  Measure with a large head
% height and foot skip so that fancyhdr neither clips the boxes nor warns about
% them; this yields the natural height without relying on package internals,
% which differ between fancyhdr releases.  The page style is set by the
% document class before this file redefines it, so activate it locally first.
% Move the difference out of the text height to keep the paper margins fixed.
\newlength{\pkgheadheight}
\newlength{\pkgfootskip}
\AtBeginDocument{%
  \begingroup
    \pagestyle{normal}%
    \setlength{\headheight}{100mm}%
    \setlength{\footskip}{100mm}%
    \setbox\@tempboxa\hbox{\@oddhead}%
    \global\pkgheadheight\ht\@tempboxa
    \setbox\@tempboxa\hbox{\@oddfoot}%
    \global\pkgfootskip\ht\@tempboxa
  \endgroup
  % Use fixed sizes if a box did not measure plausibly
  \ifdim\pkgheadheight>50mm\setlength{\pkgheadheight}{20mm}\fi
  \ifdim\pkgfootskip>50mm\setlength{\pkgfootskip}{6mm}\fi
  % Clear the deepest possible last line and mirror the header gap
  \addtolength{\pkgfootskip}{\maxdepth}%
  \addtolength{\pkgfootskip}{\headsep}%
  \addtolength{\textheight}{\headheight}%
  \addtolength{\textheight}{\footskip}%
  \setlength{\headheight}{\pkgheadheight}%
  \setlength{\footskip}{\pkgfootskip}%
  \addtolength{\textheight}{-\headheight}%
  \addtolength{\textheight}{-\footskip}%
}
\fancypagestyle{normal}{
  \fancyhf{}
  \fancyhead[L]{
    \includegraphics[height=0.5cm]{logo.pdf}
    \hfill
    {\py@HeaderFamily \small \@title} \\
    {\py@HeaderFamily \vspace{-4pt} \tiny \py@release \hfill} {\py@HeaderFamily \pkgheaderleft}
  }
  \fancyfoot[L]{
    {\py@HeaderFamily \small \pkgcopyright} \\
    {\py@HeaderFamily \pkgfooterright}
  }
  \fancyfoot[R]{\py@HeaderFamily \small \thepage}
  \renewcommand{\headrulewidth}{0.4pt}
  \renewcommand{\footrulewidth}{0.4pt}
}
\fancypagestyle{plain}{
  \fancyhf{}
  \fancyhead[L]{
    \includegraphics[height=0.5cm]{logo.pdf}
    \hfill
    {\py@HeaderFamily \small \@title} \\
    {\py@HeaderFamily \vspace{-4pt} \tiny \py@release \hfill} {\py@HeaderFamily \pkgheaderleft}
  }
  \fancyfoot[L]{
    {\py@HeaderFamily \small \pkgcopyright} \\
    {\py@HeaderFamily \pkgfooterright}
  }
  \fancyfoot[R]{\py@HeaderFamily \small \thepage}
  \renewcommand{\headrulewidth}{0.4pt}
  \renewcommand{\footrulewidth}{0.4pt}
}

