\renewcommand{\sphinxmaketitle}{
  \begin{titlepage}
    % For PDF information dictionary
    \begingroup
     \def\endgraf{ }\def\and{\& }
     \pdfstringdefDisableCommands{\def\\{, }}
     \hypersetup{pdfauthor={\@author}, pdftitle={\@title}}
    \endgroup

    \py@HeaderFamily

    \begin{tikzpicture}[remember picture,overlay]
      \node[yshift=-5cm,xshift=7cm] at (current page.north west) {
        \includegraphics[width=0.3\paperwidth]{logo.pdf}
      };
    \end{tikzpicture}

    \begin{tikzpicture}[remember picture,overlay]
    \begin{pgfonlayer}{background}
      \node[yshift=10cm] at (current page.south) {\includegraphics[width=\paperwidth,height=20cm]{blue-dots.pdf}};
    \end{pgfonlayer}
    \end{tikzpicture}

    \vspace{2.5cm}

    \begin{flushright}
    {\fontsize{50}{60}\selectfont \pkgprojecttitle}

    {\Huge Ready to Fly}

    \end{flushright}

    \vspace{6.0cm}

    \begin{flushleft}
    {\fontsize{40}{50}\selectfont \pkgtitlepagetitle}

    {\Huge \py@release}
    \end{flushleft}
  \end{titlepage}
}
% Fit the header and footer boxes to their content.  Measure with a large head
% height and foot skip so that fancyhdr neither clips the boxes nor warns about
% them; this yields the natural height without relying on package internals,
% which differ between fancyhdr releases.  The page style is set by the
% document class before this file redefines it, so activate it locally first.
% Move the difference out of the text height to keep the paper margins fixed.
\newlength{\pkgheadheight}
\newlength{\pkgfootskip}
\AtBeginDocument{%
  \begingroup
    \pagestyle{normal}%
    \setlength{\headheight}{100mm}%
    \setlength{\footskip}{100mm}%
    \setbox\@tempboxa\hbox{\@oddhead}%
    \global\pkgheadheight\ht\@tempboxa
    \setbox\@tempboxa\hbox{\@oddfoot}%
    \global\pkgfootskip\ht\@tempboxa
  \endgroup
  % Use fixed sizes if a box did not measure plausibly
  \ifdim\pkgheadheight>50mm\setlength{\pkgheadheight}{20mm}\fi
  \ifdim\pkgfootskip>50mm\setlength{\pkgfootskip}{6mm}\fi
  % Clear the deepest possible last line and mirror the header gap
  \addtolength{\pkgfootskip}{\maxdepth}%
  \addtolength{\pkgfootskip}{\headsep}%
  \addtolength{\textheight}{\headheight}%
  \addtolength{\textheight}{\footskip}%
  \setlength{\headheight}{\pkgheadheight}%
  \setlength{\footskip}{\pkgfootskip}%
  \addtolength{\textheight}{-\headheight}%
  \addtolength{\textheight}{-\footskip}%
}
\fancypagestyle{normal}{
  \fancyhf{}
  \fancyhead[L]{
    \includegraphics[height=0.5cm]{logo.pdf}
    \hfill
    {\py@HeaderFamily \small \@title} \\
    {\py@HeaderFamily \vspace{-4pt} \tiny \py@release \hfill} {\py@HeaderFamily \pkgheaderleft}
  }
  \fancyfoot[L]{
    {\py@HeaderFamily \small \pkgcopyright} \\
    {\py@HeaderFamily \pkgfooterright}
  }
  \fancyfoot[R]{\py@HeaderFamily \small \thepage}
  \renewcommand{\headrulewidth}{0.4pt}
  \renewcommand{\footrulewidth}{0.4pt}
}
\fancypagestyle{plain}{
  \fancyhf{}
  \fancyhead[L]{
    \includegraphics[height=0.5cm]{logo.pdf}
    \hfill
    {\py@HeaderFamily \small \@title} \\
    {\py@HeaderFamily \vspace{-4pt} \tiny \py@release \hfill} {\py@HeaderFamily \pkgheaderleft}
  }
  \fancyfoot[L]{
    {\py@HeaderFamily \small \pkgcopyright} \\
    {\py@HeaderFamily \pkgfooterright}
  }
  \fancyfoot[R]{\py@HeaderFamily \small \thepage}
  \renewcommand{\headrulewidth}{0.4pt}
  \renewcommand{\footrulewidth}{0.4pt}
}

% See sphinxmanual.cls
\renewenvironment{sphinxthebibliography}[1]{%
  \if@openright\cleardoublepage\else\clearpage\fi
  \begin{thebibliography}{#1}%
  \label{\detokenize{project:bibliography}}
  \addcontentsline{toc}{chapter}{\bibname}}{\end{thebibliography}}
